---
import Default from '@astrojs/starlight/components/PageTitle.astro'
import { getPageMarkdownUrl } from '../lib/docs-markdown'

const markdownUrl = getPageMarkdownUrl(Astro.locals.starlightRoute.entry.id)
const labels = Astro.currentLocale === 'en'
  ? { copy: 'Copy Markdown', copied: 'Copied', view: 'View as Markdown' }
  : { copy: 'คัดลอก Markdown', copied: 'คัดลอกแล้ว', view: 'เปิดเป็น Markdown' }
---

<Default />
<div class="tz-page-actions">
  <button type="button" data-markdown-url={markdownUrl} data-copied-label={labels.copied}>
    {labels.copy}
  </button>
  <a href={markdownUrl}>{labels.view}</a>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-markdown-url]')) {
    button.addEventListener('click', async () => {
      const label = button.textContent
      const response = await fetch(button.dataset.markdownUrl!)
      await navigator.clipboard.writeText(await response.text())
      button.textContent = button.dataset.copiedLabel!
      setTimeout(() => (button.textContent = label), 1500)
    })
  }
</script>

<style>
  .tz-page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .tz-page-actions button,
  .tz-page-actions a {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }
  .tz-page-actions button:hover,
  .tz-page-actions a:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
</style>
