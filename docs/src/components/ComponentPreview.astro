---
import { Code, TabItem, Tabs } from '@astrojs/starlight/components'
import { getDemoSource } from '../lib/demo-source'

interface Props {
  /** Demo file name in `src/components/demos/` without extension, e.g. `SearchDemo`. */
  source: string
}

const files = getDemoSource(Astro.props.source)
const labels = Astro.currentLocale === 'en'
  ? { preview: 'Preview', code: 'Code' }
  : { preview: 'ตัวอย่าง', code: 'โค้ด' }
---

<Tabs syncKey="component-preview">
  <TabItem label={labels.preview}>
    <slot />
  </TabItem>
  <TabItem label={labels.code}>
    {files.map((file) => <Code code={file.code} lang={file.lang} title={file.name} />)}
  </TabItem>
</Tabs>
